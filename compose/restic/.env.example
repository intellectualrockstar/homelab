# Container identity used for the NFS-backed repository.
PUID=1001
PGID=1001

# REST server settings.
REST_SERVER_PORT=8000
REST_SERVER_OPTIONS=--append-only --private-repos

# Keep this equal to RESTIC_REST_USERNAME when --private-repos is enabled.
RESTIC_REPOSITORY_NAME=backup
RESTIC_HOSTNAME=backup
RESTIC_REST_USERNAME=backup

# Replace both placeholders with different, strong secrets.
RESTIC_REST_PASSWORD=CHANGE_ME_REST_SERVER_PASSWORD
RESTIC_PASSWORD=CHANGE_ME_REPOSITORY_ENCRYPTION_PASSWORD
